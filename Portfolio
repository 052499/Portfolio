<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Inter', sans-serif;
    background: #0A0F1E;
    color: #E0E6F5;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* NAV */
  nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(10,15,30,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(108,99,255,0.15);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.9rem 2rem;
  }
  .nav-logo { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.1rem; color: #6C63FF; letter-spacing: 0.02em; }
  .nav-links { display: flex; gap: 2rem; }
  .nav-links a {
    color: #A9B4D4; text-decoration: none; font-size: 0.82rem; font-weight: 500;
    letter-spacing: 0.08em; text-transform: uppercase;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: #6C63FF; }

  /* HERO */
  .hero {
    min-height: 88vh;
    display: flex; flex-direction: column; justify-content: center;
    padding: 5rem 2rem 4rem;
    position: relative; overflow: hidden;
  }
  .hero-grid-bg {
    position: absolute; inset: 0;
    background-image: linear-gradient(rgba(108,99,255,0.06) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(108,99,255,0.06) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
  }
  .hero-glow {
    position: absolute; top: -120px; right: -80px;
    width: 520px; height: 520px;
    background: radial-gradient(circle, rgba(108,99,255,0.18) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-eyebrow {
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em;
    color: #6C63FF; text-transform: uppercase; margin-bottom: 1.2rem;
  }
  .hero h1 {
    font-family: 'Syne', sans-serif; font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 800; line-height: 1.1; color: #F0F4FF;
    margin-bottom: 0.5rem;
  }
  .hero h1 span { color: #6C63FF; }
  .hero-sub {
    font-family: 'Syne', sans-serif; font-size: clamp(1rem, 2.5vw, 1.4rem);
    font-weight: 400; color: #A9B4D4; margin-bottom: 1.8rem;
  }
  .terminal {
    display: inline-block;
    background: #1C2540;
    border: 1px solid rgba(108,99,255,0.3);
    border-radius: 8px;
    padding: 0.7rem 1.2rem;
    font-family: 'Courier New', monospace;
    font-size: 0.85rem;
    color: #7CFC9A;
    margin-bottom: 2.2rem;
    max-width: 480px;
  }
  .terminal .prompt { color: #6C63FF; margin-right: 6px; }
  #typed-text { border-right: 2px solid #6C63FF; animation: blink 0.9s step-end infinite; }
  @keyframes blink { 0%,100%{border-color:#6C63FF} 50%{border-color:transparent} }
  .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-primary {
    background: #6C63FF; color: #F0F4FF;
    border: none; border-radius: 6px;
    padding: 0.75rem 1.8rem; font-size: 0.88rem; font-weight: 600;
    cursor: pointer; text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    display: inline-block;
  }
  .btn-primary:hover { background: #7a72ff; transform: translateY(-1px); }
  .btn-outline {
    background: transparent; color: #A9B4D4;
    border: 1px solid rgba(169,180,212,0.35);
    border-radius: 6px; padding: 0.75rem 1.8rem;
    font-size: 0.88rem; font-weight: 600;
    cursor: pointer; text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
    display: inline-block;
  }
  .btn-outline:hover { border-color: #6C63FF; color: #6C63FF; }
  .hero-stats {
    display: flex; gap: 2.5rem; margin-top: 3.5rem;
    flex-wrap: wrap;
  }
  .stat-item { }
  .stat-num { font-family: 'Syne', sans-serif; font-size: 2rem; font-weight: 800; color: #F0F4FF; }
  .stat-label { font-size: 0.78rem; color: #6B7BA0; letter-spacing: 0.06em; text-transform: uppercase; margin-top: 2px; }

  /* SECTION WRAPPER */
  section { padding: 5rem 2rem; }
  .section-title {
    font-family: 'Syne', sans-serif; font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase; color: #6C63FF;
    margin-bottom: 0.6rem;
  }
  .section-h2 {
    font-family: 'Syne', sans-serif; font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800; color: #F0F4FF; margin-bottom: 3rem;
  }

  /* ABOUT */
  #about { background: #0A0F1E; }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  .about-text { color: #A9B4D4; font-size: 0.97rem; line-height: 1.85; }
  .about-text strong { color: #F0F4FF; font-weight: 600; }
  .about-card {
    background: #1C2540;
    border: 1px solid rgba(108,99,255,0.2);
    border-radius: 12px;
    padding: 1.6rem;
  }
  .about-card h4 { font-family: 'Syne', sans-serif; color: #F0F4FF; font-size: 0.95rem; margin-bottom: 1rem; }
  .edu-item { margin-bottom: 1.2rem; }
  .edu-item:last-child { margin-bottom: 0; }
  .edu-degree { font-size: 0.88rem; font-weight: 600; color: #E0E6F5; }
  .edu-school { font-size: 0.82rem; color: #6C63FF; margin: 2px 0; }
  .edu-meta { font-size: 0.77rem; color: #6B7BA0; }

  /* SKILLS */
  #skills { background: #0D1226; }
  .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.2rem; }
  .skill-card {
    background: #1C2540;
    border: 1px solid rgba(108,99,255,0.15);
    border-radius: 10px;
    padding: 1.3rem;
    transition: border-color 0.25s, transform 0.2s;
  }
  .skill-card:hover { border-color: rgba(108,99,255,0.5); transform: translateY(-3px); }
  .skill-card-icon { font-size: 1.4rem; margin-bottom: 0.7rem; }
  .skill-card-title { font-family: 'Syne', sans-serif; font-size: 0.82rem; font-weight: 700; color: #F0F4FF; letter-spacing: 0.05em; margin-bottom: 0.6rem; }
  .skill-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .skill-tag {
    font-size: 0.71rem; padding: 3px 8px;
    background: rgba(108,99,255,0.13);
    color: #A9B4D4;
    border: 1px solid rgba(108,99,255,0.2);
    border-radius: 4px;
  }

  /* EXPERIENCE */
  #experience { background: #0A0F1E; }
  .timeline { position: relative; padding-left: 2rem; }
  .timeline::before {
    content: '';
    position: absolute; left: 0; top: 4px; bottom: 4px; width: 2px;
    background: linear-gradient(to bottom, #6C63FF, rgba(108,99,255,0.1));
    border-radius: 2px;
  }
  .timeline-item { position: relative; margin-bottom: 3rem; }
  .timeline-item:last-child { margin-bottom: 0; }
  .timeline-dot {
    position: absolute; left: -2.42rem; top: 4px;
    width: 12px; height: 12px;
    background: #6C63FF; border-radius: 50%;
    border: 2px solid #0A0F1E;
    box-shadow: 0 0 0 3px rgba(108,99,255,0.25);
  }
  .exp-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 0.3rem; }
  .exp-role { font-family: 'Syne', sans-serif; font-size: 1.05rem; font-weight: 700; color: #F0F4FF; }
  .exp-date { font-size: 0.77rem; color: #6C63FF; font-weight: 600; white-space: nowrap; background: rgba(108,99,255,0.12); padding: 3px 10px; border-radius: 4px; }
  .exp-company { font-size: 0.88rem; color: #6C63FF; font-weight: 600; margin-bottom: 0.9rem; }
  .exp-bullets { list-style: none; }
  .exp-bullets li {
    font-size: 0.875rem; color: #A9B4D4; margin-bottom: 0.5rem;
    padding-left: 1rem; position: relative;
    line-height: 1.65;
  }
  .exp-bullets li::before {
    content: '▸'; position: absolute; left: 0;
    color: #6C63FF; font-size: 0.7rem; top: 3px;
  }

  /* PROJECTS */
  #projects { background: #0D1226; }
  .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.4rem; }
  .project-card {
    background: #1C2540;
    border: 1px solid rgba(108,99,255,0.15);
    border-radius: 12px;
    padding: 1.6rem;
    display: flex; flex-direction: column;
    transition: border-color 0.25s, transform 0.2s;
  }
  .project-card:hover { border-color: rgba(108,99,255,0.45); transform: translateY(-4px); }
  .project-header { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.8rem; }
  .project-icon {
    width: 38px; height: 38px; border-radius: 8px;
    background: rgba(108,99,255,0.2);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; flex-shrink: 0;
  }
  .project-title { font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 700; color: #F0F4FF; }
  .project-desc { font-size: 0.85rem; color: #A9B4D4; line-height: 1.7; margin-bottom: 1.2rem; flex: 1; }
  .project-stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .stack-tag {
    font-size: 0.7rem; padding: 3px 9px;
    background: rgba(108,99,255,0.1);
    color: #7C73FF;
    border: 1px solid rgba(108,99,255,0.25);
    border-radius: 4px; font-weight: 600;
  }

  /* ACHIEVEMENTS */
  #achievements { background: #0A0F1E; }
  .ach-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.2rem; }
  .ach-card {
    background: #1C2540;
    border: 1px solid rgba(108,99,255,0.12);
    border-radius: 10px;
    padding: 1.2rem 1.4rem;
    display: flex; gap: 1rem; align-items: flex-start;
  }
  .ach-icon { color: #6C63FF; font-size: 1.2rem; margin-top: 2px; flex-shrink: 0; }
  .ach-text { font-size: 0.85rem; color: #A9B4D4; line-height: 1.65; }

  /* CONTACT */
  #contact {
    background: #0D1226;
    text-align: center;
  }
  .contact-card {
    max-width: 540px; margin: 0 auto;
    background: #1C2540;
    border: 1px solid rgba(108,99,255,0.25);
    border-radius: 16px;
    padding: 3rem 2rem;
  }
  .contact-card p { color: #A9B4D4; font-size: 0.95rem; margin-bottom: 2rem; line-height: 1.75; }
  .contact-links { display: flex; flex-direction: column; gap: 0.9rem; }
  .contact-link {
    display: flex; align-items: center; gap: 0.7rem;
    background: rgba(108,99,255,0.08);
    border: 1px solid rgba(108,99,255,0.18);
    border-radius: 8px; padding: 0.8rem 1.2rem;
    color: #A9B4D4; font-size: 0.88rem;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .contact-link:hover { border-color: #6C63FF; background: rgba(108,99,255,0.16); color: #F0F4FF; }
  .contact-link-icon { color: #6C63FF; font-size: 1rem; }

  /* FOOTER */
  footer {
    background: #070B17;
    text-align: center;
    padding: 1.5rem;
    font-size: 0.77rem;
    color: #3A4560;
    letter-spacing: 0.04em;
  }

  @media (max-width: 640px) {
    .about-grid { grid-template-columns: 1fr; }
    .exp-header { flex-direction: column; gap: 0.4rem; }
    nav { padding: 0.8rem 1rem; }
    .nav-links { gap: 1rem; }
    section { padding: 3.5rem 1rem; }
    .hero { padding: 4rem 1rem 3rem; }
  }
</style>
</head>
